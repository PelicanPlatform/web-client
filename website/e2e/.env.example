# Copy to e2e/.env and fill in. All values are optional — specs that need a value
# skip themselves when it's absent, so the suite runs (partially) out of the box.

# URL under test. Defaults to the dev server Playwright launches (http://localhost:3000).
# E2E_BASE_URL=http://localhost:3000

# Point at a live/shared deployment. When set, @mutating specs (upload/delete) skip
# themselves and Playwright does NOT spawn a dev server.
# E2E_EXTERNAL=1

# Override the dev-server command (default: `pnpm dev`). Useful for `next start`, or to
# supply the machine-specific NODE_EXTRA_CA_CERTS the default dev script expects.
# E2E_WEB_SERVER_CMD=pnpm dev

# ─── Authenticated flows ────────────────────────────────────────────────────────
# Interactive OAuth can't be automated (it needs a real IdP session), so the auth
# specs SEED a token into the page's sessionStorage store instead. Provide a valid
# access-token JWT for the namespace below to exercise authenticated list/get/upload.
# E2E_TOKEN=eyJ...
# E2E_FEDERATION_HOST=osg-htc.org
# E2E_DIRECTOR_ENDPOINT=https://osdf-director.osg-htc.org
# E2E_NAMESPACE_PREFIX=/ospool/ap40

# A file path relative to the namespace prefix, used by the download spec (optional —
# otherwise the spec picks the first file it finds in the listing).
# E2E_OBJECT_HREF=/data/cannon.lock/dog_picture/IMG_8133.HEIC

# Opt-in flags for specs that need specific backends running.
# E2E_TEST_ORIGIN=1     # run the /origin (localhost Pelican stack) specs
